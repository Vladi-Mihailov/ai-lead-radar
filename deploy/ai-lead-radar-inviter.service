[Unit]
Description=AI Lead Radar Inviter Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# User/Group/WorkingDirectory/Environment — те же, что и у ai-lead-radar.service
# (см. `systemctl cat ai-lead-radar.service` на сервере) — тот же venv/аккаунт,
# отдельный процесс.
User=leadradar
Group=leadradar
WorkingDirectory=/home/leadradar/ai-lead-radar
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/leadradar/.venv/bin/python -m reader.inviter.main --worker

# SIGTERM -> InviterWorker.run_forever() дожидается завершения текущей
# безопасной операции (одна попытка приглашения — connect/warmup/pause/
# verify/disconnect, см. reader/inviter/worker.py и
# reader/inviter/main.py:_install_shutdown_handlers) и завершается сам —
# не убивать раньше, чем этот путь реально может занять (до нескольких
# минут на одну попытку).
KillSignal=SIGTERM
TimeoutStopSec=300

# on-failure (не always, как у ai-lead-radar.service) — намеренно другая
# политика: перезапуск только после НЕОЖИДАННОГО падения, не после
# штатного `systemctl stop` (см. задачу про постоянный worker-режим).
# RestartSec=10 — с небольшим запасом относительно ai-lead-radar.service
# (5s): падение здесь обычно связано с Telegram/сетью, которым нужно
# чуть больше времени на восстановление, прежде чем пробовать снова.
Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
