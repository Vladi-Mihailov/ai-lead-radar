[Unit]
Description=ai-lead-radar inviter (постоянный фоновый worker-режим)
# Отдельный сервис от ai-lead-radar.service (reader.main) — работает
# независимо, со своим набором TelegramAccount-сессий (data/sessions/*),
# никак не разделяемых с reader.main/sync_users/notifier.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=leadradar
Group=leadradar
WorkingDirectory=/home/leadradar/ai-lead-radar
ExecStart=/home/leadradar/.venv/bin/python -m reader.inviter.main --worker

# SIGTERM -> InviterWorker.run_forever() дожидается завершения текущей
# безопасной операции (одна попытка приглашения — connect/warmup/pause/
# verify/disconnect, см. reader/inviter/worker.py и
# reader/inviter/main.py:_install_shutdown_handlers) и завершается сам —
# не убивать раньше, чем этот путь реально может занять (до нескольких
# минут на одну попытку).
KillSignal=SIGTERM
TimeoutStopSec=300

# Автоматический перезапуск только после НЕОЖИДАННОГО падения (ненулевой
# exit code/сигнал) — не после штатного `systemctl stop`.
Restart=on-failure
RestartSec=15

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
