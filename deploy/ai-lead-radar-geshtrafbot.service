[Unit]
Description=AI Lead Radar ProtocolGE Bot
After=network-online.target
Wants=network-online.target

# ИСХОДНЫЙ АРТЕФАКТ — уже установлен и запущен на production под ЭТИМ
# именем юнита (ai-lead-radar-geshtrafbot.service) — имя файла/юнита НЕ
# переименовывается при переключении bot identity @GEShtrafbot ->
# @ProtocolGEbot (см. audit report), меняется только Description (косметика)
# и содержимое .env/сессия, которые этот юнит запускает. Не копировать в
# /etc/systemd/system повторно и не enable/start заново без отдельного,
# явного решения — это отдельный процесс от ai-lead-radar.service, и его
# включение означает, что @ProtocolGEbot реально начнёт принимать
# сообщения от публики.
#
# User/Group/WorkingDirectory — те же, что и у ai-lead-radar.service и
# ai-lead-radar-inviter.service (см. `systemctl cat ai-lead-radar.service`
# на сервере) — тот же venv/аккаунт, отдельный процесс, отдельная
# .session (data/sessions/protocolgebot.session, см.
# reader/public_bot/main.py — старый data/sessions/geshtrafbot.session*
# сохраняется на диске нетронутым ради rollback) и отдельные логи. .env —
# тот же файл, что и у остальных процессов (WorkingDirectory совпадает,
# load_dotenv() ищет .env в cwd) — переменная называется по-прежнему
# GESHTRAFBOT_TOKEN (см. audit report: имя переменной не переименовывается,
# меняется только её значение), должна быть заполнена НОВЫМ token'ом ДО
# первого запуска под новой identity.
[Service]
Type=simple
User=leadradar
Group=leadradar
WorkingDirectory=/home/leadradar/ai-lead-radar
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/leadradar/.venv/bin/python -m reader.public_bot.main

Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
