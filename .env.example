# Данные для Telegram API — получить на https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=+79991234567

# Имя файла live-сессии Telethon (data/sessions/<имя>.session), используемой
# main.py. Необязательно — если не задано, берётся session_name_live из
# config.yaml, а если и там нет — reader_live.
# На VPS обычно не нужно (используется reader_live по умолчанию).
# Локально стоит задать своё имя, чтобы не делить один .session с VPS —
# одновременное использование одной сессии с разных IP приводит к
# AuthKeyDuplicatedError (Telegram инвалидирует ключ авторизации).
# Пример: TELEGRAM_SESSION_NAME=reader_dev
TELEGRAM_SESSION_NAME=

# Диагностика доставки сообщений Telegram (TRACKED GROUPS, RAW EVENT,
# FILTERED EVENT, QUEUE PUT в лог) — для разбора проблем с доставкой
# апдейтов. По умолчанию выключено.
# DEBUG_TELEGRAM_EVENTS=true
DEBUG_TELEGRAM_EVENTS=false

# Список чатов (через запятую) для пересылки найденных лидов.
# Можно указывать числовой id (для приватных чатов) или username без @ (для публичных).
# Необязательно — если не задано, пересылка отключена.
# Пример: LEAD_FORWARD_TO=-1009876543210,my_leads_channel
LEAD_FORWARD_TO=

# Ключ OpenAI API для команды "insurance ocr" (распознавание документов
# автомобиля, см. reader/ocr/, config.yaml::ocr). Необязательно — если не
# задано, команда просто не поднимается (см. reader/main.py).
OPENAI_API_KEY=

# Реквизиты банковской карты для автоматической оплаты полиса на tpl.ge
# (Bank of Georgia, см. reader/checkout/payment_gateway.py). НИКОГДА не
# храните их нигде, кроме .env/secret storage — ни в config.yaml, ни в коде,
# ни в git. Все три обязательны для включения checkout — при отсутствии
# любой из них checkout просто не поднимается (fail-fast с сообщением,
# которое перечисляет только ИМЕНА переменных, см.
# reader/checkout/payment_gateway.py::CardSecrets).
# CHECKOUT_CARD_EXPIRY — формат "MM/YY".
CHECKOUT_CARD_NUMBER=
CHECKOUT_CARD_EXPIRY=
CHECKOUT_CARD_CVV=
# Необязательно — на исследованной странице оплаты (mpi.gc.ge) поля
# cardholder name НЕ обнаружено (см. reader/checkout/payment_gateway.py), но
# переменная зарезервирована на случай, если оно появляется прогрессивно
# (после ввода номера карты) и будет подтверждено следующим research'ом.
# Сейчас загружается, но никуда не подставляется.
CHECKOUT_CARDHOLDER_NAME=

# Токен публичного клиентского бота @GEShtrafbot (reader/public_bot/,
# отдельный процесс от main.py — см. deploy/ai-lead-radar-geshtrafbot.service)
# — получить у @BotFather. Используется ТОЛЬКО в
# reader/public_bot/main.py::read_bot_token(), никогда не логируется и не
# сохраняется в config.yaml/Settings. Не путать с TELEGRAM_API_ID/HASH выше —
# это токен конкретного бота, а не Telegram-приложения (оба нужны
# одновременно — Telethon в bot-mode требует и то, и другое).
GESHTRAFBOT_TOKEN=
